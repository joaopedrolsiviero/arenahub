# Copie para .env.local. Pegue as chaves reais em https://dashboard.clerk.com
# (crie uma aplicação Clerk gratuita) — nunca comite valores reais.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_change-me-in-development"
CLERK_SECRET_KEY="sk_test_change-me-in-development"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# URL do backend NestJS (com o prefixo /v1).
NEXT_PUBLIC_API_URL="http://localhost:3001/v1"

# Origem pública canônica do produto (metadataBase, sitemap.ts, robots.ts —
# ver apps/web/src/lib/site-url.ts). Opcional: sem esta variável, o código
# usa um fallback fixo. Defina em produção para a URL real do domínio em uso
# (ex.: "https://app.sivierotech.com.br").
# NEXT_PUBLIC_SITE_URL="https://app.sivierotech.com.br"
