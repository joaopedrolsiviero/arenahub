# Copie para .env e ajuste se necessário. Valores default combinam com docker-compose.yml.
# Nenhum valor aqui é um segredo real — todos são placeholders de desenvolvimento.

DATABASE_URL="postgresql://arenahub:arenahub@localhost:5432/arenahub?schema=public"
PORT=3001

# development | test | production. Nunca lido pelo código de negócio pra
# decidir banco/segurança (isso seria uma segunda fonte de verdade) — só
# usado hoje no log de startup e por convenção de ferramentas do ecossistema
# Node (Fase 9, item 56).
NODE_ENV="development"

# Redis está provisionado no docker-compose.yml (Fase 1) mas NENHUM código
# em apps/api o usa hoje — Idempotency-Key, advisory lock e prevenção de
# double booking são inteiramente PostgreSQL (ver docs/ARCHITECTURE.md,
# Parte 8). Reservado para quando BullMQ entrar (Fase 16 do roadmap); não é
# necessário provisionar Redis pra rodar a aplicação atual em produção.
REDIS_URL="redis://localhost:6379"

# Origem(ns) permitida(s) por CORS (separadas por vírgula) — a URL onde o
# apps/web roda. Sem isso, o fetch do browser para a API é bloqueado por ser
# cross-origin. Default (sem definir) já é http://localhost:3000. Em
# produção, deve ser a URL real do frontend (nunca "*" — ver
# docs/DEPLOYMENT.md).
WEB_APP_URL="http://localhost:3000"

# Chave secreta do seu app Clerk (dashboard.clerk.com -> API keys). Usada
# para verificar o JWT de sessão enviado pelo frontend (ClerkAuthGuard).
# Em produção, use a chave do ambiente de PRODUÇÃO do Clerk, nunca a de
# desenvolvimento.
CLERK_SECRET_KEY="sk_test_change-me-in-development"

# Signing secret do endpoint de webhook (dashboard.clerk.com -> Webhooks ->
# seu endpoint -> Signing Secret). Usada para verificar a assinatura Svix de
# POST /v1/webhooks/clerk — nunca aceite um payload sem essa verificação.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_change-me-in-development"

# Opcional — identifica a versão em execução nos logs de startup (Fase 9,
# item 95). Normalmente o SHA curto do commit, injetado pela plataforma de
# deploy ou pelo CI; nunca inventado manualmente. Sem essa variável, o log
# de startup simplesmente omite a versão.
# APP_VERSION="git-sha-curto-ou-tag"

# Opcional (Fase 11) — dias até um convite de equipe (ArenaInvitation)
# expirar. Default no próprio código (InvitationsService) é 7 se esta
# variável não for definida. Não é secret.
# INVITATION_EXPIRES_DAYS=7

# Fase 12 (assistente de IA operacional) — chave secreta da API da OpenAI
# (platform.openai.com -> API keys). SEM ela, o endpoint POST
# /v1/arenas/:arenaId/ai/ask responde 503 (assistente indisponível) — a IA
# NÃO é obrigatória pro resto da API subir (não está em REQUIRED_ENV_VARS do
# main.ts), diferente de Clerk/DATABASE_URL. Nunca chega ao frontend, nunca é
# logada (ver docs/DEPLOYMENT.md).
# AI_PROVIDER_API_KEY="sk-change-me-in-development"

# Opcional (Fase 12) — modelo da OpenAI usado pelo assistente. Default no
# código (OpenAiAiProviderService) é "gpt-4o-mini" se esta variável não for
# definida.
# AI_PROVIDER_MODEL="gpt-4o-mini"

# Opcional (Fase 12) — timeout (ms) de cada chamada à OpenAI antes de
# desistir e responder 503. Default no código é 15000 (15s).
# AI_PROVIDER_TIMEOUT_MS=15000

# Fase 16 (canal de WhatsApp) — nenhuma destas é obrigatória pra API subir
# (não está em REQUIRED_ENV_VARS do main.ts), igual à Fase 12: sem elas, o
# webhook simplesmente rejeita o handshake de verificação (GET) e falha ao
# enviar mensagens (POST continua processando e persistindo o estado da
# conversa, só a resposta não sai) — ver docs/ARCHITECTURE.md, Fase 16.

# Token arbitrário que você mesmo escolhe e cadastra no painel da Meta for
# Developers ao configurar o webhook — usado só pra validar o handshake de
# verificação (GET /v1/webhooks/whatsapp?hub.verify_token=...).
# WHATSAPP_VERIFY_TOKEN="change-me-in-development"

# App Secret do seu app da Meta (developers.facebook.com -> seu app ->
# Configurações básicas) — usado para verificar a assinatura HMAC-SHA256
# (X-Hub-Signature-256) de todo POST /v1/webhooks/whatsapp. Nunca aceite um
# payload sem essa verificação (mesma disciplina do webhook do Clerk).
# WHATSAPP_APP_SECRET="change-me-in-development"

# Token de acesso (permanente, de uma System User) da WhatsApp Business
# Platform — usado para ENVIAR mensagens via Graph API. Sem ele, o
# MetaWhatsAppProviderService loga um aviso e a resposta simplesmente não é
# entregue (o estado da conversa já avançou normalmente no backend).
# WHATSAPP_ACCESS_TOKEN="change-me-in-development"

# Cada Arena configura o próprio `phone_number_id` da Meta via
# PATCH /v1/arenas/:arenaId (campo whatsappPhoneNumberId, OWNER/ADMIN) — não
# é uma variável de ambiente global, porque cada arena pode ter seu próprio
# número de WhatsApp Business.
