# Copie para .env e ajuste se necessário. Valores default combinam com docker-compose.yml.
# Nenhum valor aqui é um segredo real — todos são placeholders de desenvolvimento.

DATABASE_URL="postgresql://arenahub:arenahub@localhost:5432/arenahub?schema=public"
PORT=3001

# development | test | production. Nunca lido pelo código de negócio pra
# decidir banco/segurança (isso seria uma segunda fonte de verdade) — só
# usado hoje no log de startup e por convenção de ferramentas do ecossistema
# Node (Fase 9, item 56).
NODE_ENV="development"

# Redis está provisionado no docker-compose.yml (Fase 1) mas NENHUM código
# em apps/api o usa hoje — Idempotency-Key, advisory lock e prevenção de
# double booking são inteiramente PostgreSQL (ver docs/ARCHITECTURE.md,
# Parte 8). Reservado para quando BullMQ entrar (Fase 12 do roadmap); não é
# necessário provisionar Redis pra rodar a aplicação atual em produção.
REDIS_URL="redis://localhost:6379"

# Origem(ns) permitida(s) por CORS (separadas por vírgula) — a URL onde o
# apps/web roda. Sem isso, o fetch do browser para a API é bloqueado por ser
# cross-origin. Default (sem definir) já é http://localhost:3000. Em
# produção, deve ser a URL real do frontend (nunca "*" — ver
# docs/DEPLOYMENT.md).
WEB_APP_URL="http://localhost:3000"

# Chave secreta do seu app Clerk (dashboard.clerk.com -> API keys). Usada
# para verificar o JWT de sessão enviado pelo frontend (ClerkAuthGuard).
# Em produção, use a chave do ambiente de PRODUÇÃO do Clerk, nunca a de
# desenvolvimento.
CLERK_SECRET_KEY="sk_test_change-me-in-development"

# Signing secret do endpoint de webhook (dashboard.clerk.com -> Webhooks ->
# seu endpoint -> Signing Secret). Usada para verificar a assinatura Svix de
# POST /v1/webhooks/clerk — nunca aceite um payload sem essa verificação.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_change-me-in-development"

# Opcional — identifica a versão em execução nos logs de startup (Fase 9,
# item 95). Normalmente o SHA curto do commit, injetado pela plataforma de
# deploy ou pelo CI; nunca inventado manualmente. Sem essa variável, o log
# de startup simplesmente omite a versão.
# APP_VERSION="git-sha-curto-ou-tag"
