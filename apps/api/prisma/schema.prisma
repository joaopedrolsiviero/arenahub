// Fase 2: primeiro model de domínio (User), necessário para autenticação.
// Fase 3: domínio de Arena/Quadra (Arena, ArenaMember, Court).
// Fase 4: núcleo de reservas (Booking, disponibilidade, idempotência).
// Fase 5: timezone real da Arena + horário de funcionamento
// (ArenaOperatingHours), disponibilidade deixa de ser uma grade matemática
// e passa a respeitar quando a arena está de fato aberta.
// Fase 6: experiência de reserva do cliente (frontend) — sem novos models,
// só o índice por userId em Booking (consulta "minhas reservas"). O
// restante do schema de negócio (Payment...) chega nas fases seguintes,
// seguindo docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Espelha o usuário do Clerk (ARCHITECTURE.md, Parte 7). Não tem campo de
// "papel" global — o papel é sempre relativo a uma arena, via ArenaMember.
// `id` usa cuid() (Prisma-recomendado para IDs distribuídos, sem depender de
// nenhuma extensão do Postgres) — decisão registrada por não estar explícita
// na arquitetura, e reaplicada em todos os models novos para manter um único
// padrão de identificador no projeto.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  // Sincronizado do Clerk (UsersService.syncFromClerkEvent), sempre em E.164
  // (Clerk já entrega nesse formato; normalizado de novo na sincronização
  // por defesa em profundidade). Fase 16: é o único identificador de
  // vínculo entre um número de WhatsApp e um User — nenhuma identidade
  // paralela foi criada. `@unique` porque a resolução de identidade do
  // WhatsApp (`UsersService.findByPhone`) precisa de um match exato e
  // inequívoco; nulo continua permitido (múltiplos usuários sem telefone
  // cadastrado no Clerk), Postgres trata cada NULL como distinto sob UNIQUE.
  phone     String?  @unique
  avatarUrl String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  arenaMemberships      ArenaMember[]
  bookings              Booking[]              @relation("BookingUser")
  cancelledBookings     Booking[]              @relation("BookingCancelledBy")
  sentInvitations       ArenaInvitation[]      @relation("InvitationInvitedBy")
  acceptedInvitations   ArenaInvitation[]      @relation("InvitationAcceptedBy")
  whatsappConversations WhatsAppConversation[]
  payments              Payment[]
  pushTokens            PushToken[]
}

// Papel do usuário dentro de uma arena específica (nunca um campo global).
// STAFF fica para quando precisar de permissões mais granulares — adicionar
// um valor de enum não exige mudança estrutural.
enum ArenaRole {
  OWNER
  ADMIN
}

// Modalidade esportiva de uma quadra. Enum simples nesta fase (só
// beach volley) em vez do catálogo `Sport` previsto na Parte 7 do
// ARCHITECTURE.md — decisão explícita da Fase 3, documentada em
// "Decisões revisadas na v0.3". Novas modalidades = novo valor de enum,
// sem mudança estrutural.
enum Sport {
  BEACH_VOLLEYBALL
}

// Como o cliente paga uma reserva CUSTOMER desta arena — configuração POR
// ARENA (nunca global), com ONLINE como default explícito pra nunca mudar
// o comportamento de uma arena já existente sem ação do OWNER/ADMIN.
enum PaymentMode {
  ONLINE
  IN_PERSON
}

// Estabelecimento esportivo. Campos deliberadamente mínimos nesta fase —
// endereço, imagens e status (previstos na Parte 7 do ARCHITECTURE.md para o
// marketplace/disponibilidade futuros) chegam quando a fase que realmente
// precisar deles for implementada.
model Arena {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  description           String?
  phone                 String?
  email                 String?
  // Identificador IANA (ex: "America/Sao_Paulo") — nunca offset fixo
  // ("-03:00") nem sigla ("GMT-3"), justamente para que DST seja resolvido
  // corretamente pela biblioteca de timezone, não calculado à mão (Fase 5).
  // Todas as quadras da arena seguem esse timezone — não existe
  // Court.timezone (ver docs/ARCHITECTURE.md, Fase 5).
  timezone              String   @default("America/Sao_Paulo")
  // Fase 16: identificador ESTÁVEL do número de WhatsApp Business desta
  // arena, fornecido pela Meta Cloud API (`entry[].changes[].value.metadata.
  // phone_number_id` em todo evento de webhook) — nunca o número de telefone
  // em si, que pode ser reformatado/portado; o `phone_number_id` é a chave
  // que a própria Meta usa para identificar a conta de origem. É assim que o
  // webhook (compartilhado por todas as arenas) resolve qual arena está
  // recebendo cada mensagem, sem jamais comparar strings de telefone (item 8
  // do prompt da fase). Nulo = esta arena ainda não tem WhatsApp configurado
  // (a maioria, nesta fase — configurar é uma ação explícita do OWNER via
  // `PATCH /arenas/:arenaId`, reaproveitando a autorização já existente).
  whatsappPhoneNumberId String?  @unique
  // Fase de melhorias no fluxo de reserva: cada arena decide se o cliente
  // paga pelo site (Mercado Pago, fluxo já existente desde a Fase 17) ou
  // presencialmente (o ArenaHub só agenda, sem gerar Payment/PIX nenhum).
  // Default ONLINE — preserva o comportamento atual de toda arena já
  // existente sem exigir nenhuma migração de dado.
  paymentMode           PaymentMode @default(ONLINE)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  members               ArenaMember[]
  courts                Court[]
  operatingHours        ArenaOperatingHours[]
  invitations           ArenaInvitation[]
  whatsappConversations WhatsAppConversation[]
  payments              Payment[]
}

// Dia da semana centralizado num enum — nunca um inteiro solto (0=domingo
// vs. 1=domingo é uma fonte clássica de bug se espalhado pelo código).
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Horário de funcionamento — pertence à Arena, não à Court (Fase 5: todas
// as quadras de uma arena tipicamente compartilham o mesmo horário de
// funcionamento; modelar por quadra duplicaria configuração sem necessidade
// real hoje — ver docs/ARCHITECTURE.md). Múltiplas linhas por
// `(arenaId, dayOfWeek)` representam múltiplos intervalos no mesmo dia (ex:
// abre de manhã, fecha para almoço, reabre à tarde). Um dia sem nenhuma
// linha significa "fechado" — nunca uma linha-sentinela 00:00→00:00.
//
// `opensAt`/`closesAt` são minutos desde a meia-noite LOCAL (0-1439), não um
// timestamp — mesmo padrão já usado para `bufferMinutes`/
// `slotDurationMinutes` em Court, e evita a ambiguidade de um `@db.Time` do
// Postgres carregando uma data espúria via Prisma. Intervalos que atravessam
// a meia-noite (overnight, ex: 22:00→02:00) não são suportados nesta fase —
// decisão explícita pela alternativa mais simples (ver Fase 5, item 12):
// todo intervalo deve estar contido no mesmo dia civil (`closesAt >
// opensAt`, sempre).
model ArenaOperatingHours {
  id        String  @id @default(cuid())
  arenaId   String
  dayOfWeek Weekday
  opensAt   Int
  closesAt  Int

  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@index([arenaId, dayOfWeek])
}

// Tabela de junção User<->Arena — a mesma pensada desde a Parte 7 do
// ARCHITECTURE.md. `invitedAt`/`acceptedAt` (fluxo de convite) ficam para
// quando existir de fato um fluxo de convite; por ora a associação nasce
// sempre já "efetivada" (criador da arena vira OWNER direto).
// Fase 10: "no máximo um OWNER por arena" é garantido por um índice único
// PARCIAL sobre (arenaId) WHERE role = 'OWNER' — Prisma não tem sintaxe para
// índice parcial no schema, então ele existe só na migration SQL manual
// (`arena_member_single_owner`), mesma técnica já usada para a EXCLUDE
// constraint de Booking. Não é um UNIQUE(arenaId) comum: isso impediria
// múltiplos ADMIN na mesma arena, o que é permitido.
model ArenaMember {
  id        String    @id @default(cuid())
  arenaId   String
  userId    String
  role      ArenaRole
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([arenaId, userId])
  @@index([userId])
}

// Fase 11: convite pendente pra alguém virar ArenaMember(role=ADMIN) de uma
// arena. Deliberadamente SEM FK obrigatória pra User — o convidado pode
// ainda não ter conta no ArenaHub (item 5 do prompt da fase); `email` é o
// identificador do convite até o aceite associá-lo a um User real via
// `acceptedByUserId`. Nunca guarda o token em texto puro — só `tokenHash`
// (SHA-256 de um token de 256 bits gerado por `crypto.randomBytes`, nunca
// reversível). Estado (PENDING/ACCEPTED/REVOKED/EXPIRED) é deliberadamente
// DERIVADO de `acceptedAt`/`revokedAt`/`expiresAt` no service, não um enum
// próprio — evita um campo que pudesse ficar dessincronizado dos timestamps
// que já carregam a mesma informação (item 12 do prompt).
//
// "No máximo um convite ainda aberto (nem aceito, nem revogado) por
// (arenaId, email, role)" é garantido por um índice único PARCIAL — mesma
// técnica manual já usada para o único-OWNER da Fase 10, porque Prisma não
// tem sintaxe de schema pra índice parcial. Ver a migration desta fase.
model ArenaInvitation {
  id        String    @id @default(cuid())
  arenaId   String
  // Sempre normalizado (trim + lowercase) antes de persistir — mesma regra
  // usada em toda consulta/comparação (item 6 do prompt).
  email     String
  role      ArenaRole
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  acceptedAt DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)

  // Nulável + SetNull (não Cascade): se o User que convidou for removido
  // (ex: user.deleted do Clerk), o convite continua existindo como
  // histórico (item 42) — mesmo padrão já usado por
  // `Booking.cancelledByUserId`.
  invitedByUserId  String?
  acceptedByUserId String?

  arena          Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  invitedBy      User? @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedByUser User? @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([arenaId])
  @@index([email])
}

// Quadra de uma arena. `pricePerSlot`/`slotDurationMinutes`/`bufferMinutes`
// chegam agora (Fase 4) — são exatamente os campos que a Fase 3 disse que
// "não fazem sentido sem o sistema que os consome" (Booking/disponibilidade).
model Court {
  id                  String   @id @default(cuid())
  arenaId             String
  name                String
  sport               Sport
  description         String?
  isActive            Boolean  @default(true)
  // Preço de um slot, congelado em Booking.total na criação da reserva —
  // nunca recalculado depois (ARCHITECTURE.md, "Regra de preço no MVP").
  pricePerSlot        Decimal  @default(0) @db.Decimal(10, 2)
  // Duração fixa de toda reserva de CUSTOMER nesta quadra (minutos).
  slotDurationMinutes Int      @default(60)
  // Minutos de buffer obrigatório após uma reserva de CUSTOMER antes do
  // próximo horário ficar disponível. Não se aplica a BLOCK/MAINTENANCE.
  bufferMinutes       Int      @default(0)
  // URL de uma imagem já hospedada externamente (o OWNER cola o link) —
  // deliberadamente NÃO um upload de arquivo: o projeto não tem nenhuma
  // infraestrutura de armazenamento de mídia (S3/Cloudinary/etc.) hoje, e
  // criar uma só para isso seria a "solução externa complexa" que esta
  // fase pediu explicitamente pra evitar. Nulo = sem foto, o frontend usa
  // um placeholder neutro.
  imageUrl            String?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  arena    Arena     @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([arenaId, name])
}

// Origem da ocupação — nunca confundir com o ciclo de vida (BookingStatus).
enum BookingType {
  CUSTOMER
  BLOCK
  MAINTENANCE
}

// Ciclo de vida da ocupação nesta fase. Estados ligados a pagamento
// (PENDING_PAYMENT, REFUNDED...) ficam fora — pagamento é fase futura e
// Booking não depende dele.
enum BookingStatus {
  CONFIRMED
  CANCELLED
}

// Representa a ocupação de uma quadra em um intervalo de tempo — nunca
// "reserva de cliente" apenas. `type` diferencia a origem (CUSTOMER/BLOCK/
// MAINTENANCE); todas ocupam a quadra da mesma forma para efeito de
// conflito (ver a exclusion constraint na migration desta fase).
//
// Sem `arenaId` denormalizado: não está entre os campos mínimos pedidos, e
// a cadeia arena→court já é validada via CourtsService antes de qualquer
// operação em Booking.
model Booking {
  id      String        @id @default(cuid())
  courtId String
  // Sempre preenchido na prática (cliente que reservou, ou admin que criou
  // o bloqueio/manutenção) — nulável no schema para não impor uma
  // dependência rígida a User em casos futuros (ex: bloqueio programático).
  userId  String?
  type    BookingType
  status  BookingStatus @default(CONFIRMED)

  startsAt DateTime @db.Timestamptz(6)
  endsAt   DateTime @db.Timestamptz(6)

  // Cópia congelada de Court.bufferMinutes no momento da criação — usada
  // pela exclusion constraint (não pode depender de uma coluna mutável de
  // outra tabela). Sempre 0 para BLOCK/MAINTENANCE.
  bufferMinutesSnapshot Int @default(0)

  // Congelado no momento da criação (Decimal, nunca float) — 0 para
  // BLOCK/MAINTENANCE. Nunca recalculado depois.
  total Decimal @default(0) @db.Decimal(10, 2)

  // Motivo/descrição administrativa — só relevante para BLOCK/MAINTENANCE
  // ("campos necessários para identificar a origem administrativa").
  reason String?

  cancelledAt       DateTime? @db.Timestamptz(6)
  cancelledByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // onDelete: Restrict — histórico de reservas nunca deve desaparecer junto
  // com a quadra (diferente de ArenaMember, que é vínculo, não registro
  // histórico). Não há endpoint de exclusão de Court ainda; a constraint
  // fica pronta para quando existir.
  court           Court     @relation(fields: [courtId], references: [id], onDelete: Restrict)
  user            User?     @relation("BookingUser", fields: [userId], references: [id], onDelete: SetNull)
  cancelledByUser User?     @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  payments        Payment[]
  // A proteção real contra conflito (EXCLUDE USING GIST) é adicionada via
  // SQL manual na migration desta fase — Prisma não tem sintaxe para
  // exclusion constraints. Ver migration `booking_availability`.

  @@index([courtId, startsAt])
  // Fase 6: "minhas reservas" passou a consultar Booking por userId — sem
  // esse índice seria table scan. Já estava anotado como índice "eventual"
  // desde a Parte 7 do ARCHITECTURE.md (Fase 4); implementado agora que a
  // primeira query real por userId existe.
  @@index([userId])
}

// Idempotência para operações que podem ser repetidas (Idempotency-Key),
// persistida no Postgres — sobrevive a restart e múltiplas instâncias, e é
// segura sob concorrência real via o índice único abaixo (não usa memória
// local nem depende de Redis).
model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String
  userId         String
  // Identificador lógico da operação (ex: "bookings.customer.create") —
  // não a URL literal, para não acoplar à forma exata da rota.
  endpoint       String
  // Hash determinístico do payload relevante — mesma chave com payload
  // diferente é rejeitada (409), não silenciosamente aceita.
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, endpoint, key])
}

// Fase 16: estado explícito da conversa de um cliente com UMA arena pelo
// WhatsApp — o backend é a autoridade sobre esse estado, nunca o LLM (item
// 11/34 do prompt). Estados ligados a pagamento não existem aqui (Fase 17).
enum WhatsAppConversationState {
  IDLE
  SELECTING_DATE
  SELECTING_TIME
  SELECTING_COURT
  CONFIRMING_BOOKING
  PROCESSING_BOOKING
  BOOKING_CONFIRMED
  CANCEL_SELECTING
  CANCEL_CONFIRMATION
  PROCESSING_CANCELLATION
}

// Uma linha por (arena, cliente) — não por "sessão"/"thread": um mesmo
// cliente conversando com a MESMA arena sempre continua a mesma conversa
// lógica; conversar com OUTRA arena (outro número de WhatsApp) é uma linha
// separada, o que já garante isolamento multi-tenant estrutural (nunca
// existe uma linha compartilhada entre arenas — item 9 do prompt).
//
// Campos "pending*" guardam só o MÍNIMO necessário para retomar o fluxo
// (item 12 — nunca a conversa inteira, nunca o texto das mensagens em si).
// Tudo aqui é sempre REVALIDADO contra o domínio antes de qualquer escrita
// (item 33 — "never trust the model", e o mesmo vale pro próprio estado
// persistido: ele é conveniência de retomada, nunca autoridade final).
model WhatsAppConversation {
  id      String @id @default(cuid())
  arenaId String
  userId  String

  state WhatsAppConversationState @default(IDLE)

  // Opções numeradas apresentadas na última mensagem (courtId+nome+preço
  // para SELECTING_COURT, ou bookingId+resumo para CANCEL_SELECTING) — só
  // pra resolver "2" na resposta seguinte sem uma segunda pergunta ao
  // cliente; o backend SEMPRE revalida o item escolhido contra o banco
  // antes de agir (nunca confia que a opção ainda é válida só porque foi
  // oferecida há pouco — item 64/68).
  pendingOptions Json?

  // Slots coletados durante a coleta de data/hora de uma criação de reserva.
  pendingDate    String? // YYYY-MM-DD, já resolvido deterministicamente (nunca pelo LLM — item 27)
  pendingTime    String? // HH:mm
  pendingCourtId String?

  // Reserva alvo de um cancelamento em andamento.
  pendingBookingId String?

  // Idempotency-Key persistente da AÇÃO lógica atual (item 19) — gerada uma
  // vez ao entrar em CONFIRMING_BOOKING, nunca regenerada por retry do
  // webhook (a mesma intenção de reserva sempre usa a mesma chave).
  pendingActionId String?

  // TTL de uma confirmação pendente (item 35) — 15 minutos desde que o
  // estado entrou em CONFIRMING_BOOKING/CANCEL_CONFIRMATION. Expirado =
  // tratado como se o cliente tivesse que recomeçar, nunca uma confirmação
  // "ainda válida" por tempo indefinido.
  expiresAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([arenaId, userId])
}

// Deduplicação de eventos do webhook do WhatsApp (item 6 do prompt) — o
// provider pode entregar o mesmo evento mais de uma vez; processar duas
// vezes o mesmo `providerEventId` (o `id` da mensagem, "wamid...") nunca
// pode gerar uma segunda reserva/cancelamento nem uma segunda resposta.
// Mesma técnica "claim-first" do IdempotencyKey (Fase 4): o INSERT com
// `providerEventId` único é o primeiro passo — se já existir, o evento é
// ignorado sem reprocessar nada.
model WhatsAppEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
}

// Fase 17 — gateway de pagamento. Só Mercado Pago é suportado nesta fase
// (item 8 da auditoria: PIX nativo, sandbox sem CNPJ, webhook assinado —
// ver docs/ARCHITECTURE.md, "Fase 17", pra justificativa completa). Enum
// (não uma string livre) porque `Payment.provider` precisa ser um valor
// fechado — igual ao padrão já usado em `WhatsAppConversationState`.
enum PaymentProvider {
  MERCADO_PAGO
}

// Ciclo de vida FINANCEIRO — nunca confundido com BookingStatus (item 2 do
// prompt da fase: Booking continua representando só a ocupação da quadra).
// Desenho deliberado: PENDING é o ÚNICO estado não-terminal. Todos os
// outros (PAID/FAILED/EXPIRED/CANCELLED) são terminais e IMUTÁVEIS — uma
// vez alcançados, nenhum evento posterior (nem um webhook "atrasado") pode
// mudar o Payment de novo (ver PaymentService.applyTerminalStatus, CAS
// condicionado a `status: PENDING`). Isso resolve de uma vez os dois
// exemplos de webhook fora de ordem do prompt (item 9): PAID nunca volta
// pra FAILED; EXPIRED nunca vira PAID mesmo que o provider confirme depois.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  // Alcançado só quando a Booking subjacente é cancelada ENQUANTO um
  // Payment ainda está PENDING (nunca por ação direta do cliente — não
  // existe endpoint para "desistir" de um pagamento nesta fase, decisão
  // deliberada de escopo mínimo).
  CANCELLED
  // Fase 27 — reembolso solicitado, ainda não confirmado pelo Mercado
  // Pago. Necessário porque reembolso de PIX pode ser assíncrono
  // (`status: "in_process"` na API real, confirmado na documentação
  // oficial) — nunca soubemos supor "reembolso é sempre instantâneo".
  // Um Payment pode ficar aqui por um tempo real antes de virar REFUNDED;
  // nunca marcado como sucesso sem confirmação do provider.
  REFUNDING
  // Terminal — confirmado pelo Mercado Pago (`status: "approved"` na
  // resposta do refund, ou reconciliado depois via consulta). Nunca um
  // segundo refund é permitido depois disso (item 6 do prompt da Fase 27).
  REFUNDED
}

// Fase 17: ciclo financeiro de uma Booking CUSTOMER, deliberadamente
// separado do ciclo operacional (Booking.status). Uma Booking pode ter
// VÁRIOS Payment (tentativas — permite retry após FAILED/EXPIRED sem
// duplicar cobrança efetiva), mas no máximo UM pode estar PAID por vez —
// garantido pelo índice único parcial `Payment_bookingId_single_paid` (SQL
// manual na migration desta fase, mesma técnica já usada para "no máximo um
// OWNER por arena", Fase 10). Isso evolui deliberadamente a cardinalidade
// 1–1 sugerida na Parte 7 original do ARCHITECTURE.md (escrita antes de
// qualquer implementação real) para 1–N tentativas / 1 liquidação — ver
// "Decisões revisadas na v0.17" para o registro completo dessa mudança.
//
// `arenaId`/`userId` são denormalizados DELIBERADAMENTE (nunca só
// deriváveis via `booking.court.arenaId`/`booking.userId`): é assim que o
// webhook do provider e as consultas administrativas conseguem filtrar por
// arena/cliente sem um JOIN até Booking→Court em toda query financeira, e
// principalmente porque é isso que garante isolamento multi-tenant
// verificável diretamente na tabela de pagamentos (auditoria/reconciliação
// financeira nunca deveria depender de uma cadeia de joins pra provar que
// um Payment pertence à arena certa). Risco de inconsistência é nulo na
// prática: os dois valores são copiados da MESMA Booking no momento da
// criação do Payment e nunca mudam depois (Booking.userId/court.arenaId
// também são efetivamente imutáveis após a criação).
model Payment {
  id        String  @id @default(cuid())
  bookingId String
  userId    String
  arenaId   String
  // Nunca float (item 3 do prompt) — mesmo padrão de `Booking.total`.
  // Congelado a partir de `Booking.total` no momento da criação do
  // Payment, nunca aceito do cliente (item 4).
  amount    Decimal @db.Decimal(10, 2)
  currency  String  @default("BRL")

  status   PaymentStatus   @default(PENDING)
  provider PaymentProvider

  // Preenchido só DEPOIS da chamada ao provider (fora de qualquer
  // transação Prisma — item 24 do prompt: nunca finja que uma transação
  // Postgres torna uma chamada HTTP externa atomicamente transacional).
  // `@unique` quando não nulo: nunca dois Payment locais apontando pro
  // mesmo pagamento no provider.
  providerPaymentId String? @unique

  // Devolvidos pelo provider só na criação (a API do Mercado Pago não
  // reenvia isso numa consulta de status) — persistidos aqui pra que toda
  // consulta subsequente (GET /payment, usado pelo polling do frontend)
  // consiga mostrar o mesmo QR/link, não só a resposta imediata do POST.
  // Achado real na Fase 23: sem persistir, o QR nunca aparecia (o
  // frontend deliberadamente só confia no estado devolvido pelo backend,
  // nunca em resposta de mutation guardada em memória).
  checkoutUrl  String?
  pixCopyPaste String?
  // Imagem PNG do QR Code, em base64 — potencialmente vários KB, por isso
  // @db.Text (não o VARCHAR curto default do Postgres pro Prisma String).
  qrCodeBase64 String? @db.Text

  // Fase 27 — ID do refund NO PROVIDER (nunca confiado sozinho: só usado
  // pra reconsultar o status real depois, mesmo espírito de
  // `providerPaymentId`). `@unique` quando não nulo: nunca dois refunds
  // locais apontando pro mesmo refund no provider.
  refundId   String?   @unique
  refundedAt DateTime? @db.Timestamptz(6)

  // Idempotência da CRIAÇÃO (item 10 do prompt) — mesma técnica
  // "claim-first" já estabelecida em IdempotencyKey/WhatsAppEvent, aplicada
  // diretamente aqui (não uma segunda tabela): duas requisições com a MESMA
  // chave pra mesma Booking sempre resolvem pro mesmo Payment, nunca criam
  // duas tentativas nem duas cobranças no provider. Chaves DIFERENTES para
  // a mesma Booking são tentativas genuinamente distintas — permitido, mas
  // resolvido por um lock consultivo por bookingId no momento da criação
  // (ver PaymentsService), nunca duas tentativas ATIVAS simultâneas.
  idempotencyKey String

  failureReason String?

  paidAt    DateTime? @db.Timestamptz(6)
  // Prazo da tentativa atual (PIX expira) — avaliado em tempo de leitura
  // (mesmo padrão de `ArenaInvitation.expiresAt`, Fase 11: nunca um job/cron
  // marcando expiração; a transição PENDING->EXPIRED acontece lazily, no
  // primeiro acesso após o prazo vencer).
  expiresAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // onDelete: Restrict em todas as três relações — um registro financeiro
  // nunca pode desaparecer como efeito colateral de excluir a Booking/User/
  // Arena relacionados (mesmo espírito de `Booking.court`, Fase 4).
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  arena   Arena   @relation(fields: [arenaId], references: [id], onDelete: Restrict)
  // O índice único parcial "no máximo um PAID por bookingId" é adicionado
  // via SQL manual na migration desta fase (Prisma não tem sintaxe pra
  // índice parcial — mesma situação já registrada para a EXCLUDE constraint
  // de Booking e o único-OWNER de ArenaMember).

  @@unique([bookingId, idempotencyKey])
  @@index([bookingId])
  @@index([arenaId])
  @@index([userId])
}

// Deduplicação de eventos do webhook de pagamento (item 8 do prompt) —
// mesma técnica "claim-first" do WhatsAppEvent (Fase 16): o provider pode
// reenviar a mesma notificação mais de uma vez, e processá-la duas vezes
// nunca pode aplicar o mesmo efeito duas vezes (a máquina de estados do
// Payment já é idempotente por si via CAS, mas isso evita até reprocessar
// — nunca chamar `getPaymentStatus` no provider duas vezes à toa pro mesmo
// evento).
model PaymentWebhookEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  providerEventId String
  receivedAt      DateTime        @default(now()) @db.Timestamptz(6)
  processedAt     DateTime?       @db.Timestamptz(6)
  // Metadado seguro só ("processed"/"ignored"/"error" + um motivo curto) —
  // NUNCA o payload bruto do webhook (item 8 do prompt: "não armazene
  // payloads contendo secrets desnecessariamente").
  resultSummary   String?

  @@unique([provider, providerEventId])
}

// Fase M7 (Mobile) — token de push (Expo Push Token) do dispositivo,
// associado ao usuário AUTENTICADO que o registrou (nunca a um `userId`
// enviado pelo cliente — ver PushTokensController). `token` é
// globalmente `@unique`: o mesmo dispositivo físico nunca tem duas linhas
// (reinstalação/token novo do Expo é tratado como upsert-por-token, não
// como um registro paralelo); reassociar o MESMO token a outro usuário
// (logout + login de outra conta no mesmo aparelho) é uma escrita normal
// nesta mesma linha, nunca uma segunda identidade. `platform` não é um enum
// fechado (`String`) de propósito — o Expo pode introduzir uma nova
// plataforma (ex: "web") sem exigir migration aqui.
// `onDelete: Cascade`: diferente de Booking/Payment (histórico que nunca
// pode desaparecer), um token de push não tem valor nenhum sem o usuário
// dono — apagar o usuário libera os tokens junto, sem constraint órfã.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
